# 提供元（現在は osm のみ）
VITE_PROVIDER=osm

# Overpass API のエンドポイント。カンマ区切りで最大 3 件まで指定でき、先頭から順に試す
# 混雑（HTTP 429・502・503・504）、通信エラー、タイムアウト（1 か所あたり 15 秒）のときに次のエンドポイントに切り替える
# 未指定の場合は、既定の 2 件（maps.mail.ru → overpass-api.de の順）を使う
# NextGIS（https://nextgis.com/ で無料の API キーを取得）を使う場合は、先頭に加える。キーはリポジトリに書かない
#   例：https://overpass.nextgis.com/<APIキー>/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass-api.de/api/interpreter
VITE_OVERPASS_URL=https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass-api.de/api/interpreter

# Nominatim のエンドポイント
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org

# 初回起動時の地図の中心（緯度,経度）。既定値は萩駅
VITE_DEFAULT_CENTER=34.393885,131.401059

# 初回起動時のズーム
VITE_DEFAULT_ZOOM=15

# 公開 URL のパス。GitHub Pages では /{リポジトリ名}/ を指定する
VITE_BASE_PATH=/
