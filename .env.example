# 提供元（現在は osm のみ）
VITE_PROVIDER=osm

# Overpass API のエンドポイント（混雑時は別の公開インスタンスに切り替える）
VITE_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Nominatim のエンドポイント
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org

# 初回起動時の地図の中心（緯度,経度）。既定値は萩駅
VITE_DEFAULT_CENTER=34.393885,131.401059

# 初回起動時のズーム
VITE_DEFAULT_ZOOM=15

# 公開 URL のパス。GitHub Pages では /{リポジトリ名}/ を指定する
VITE_BASE_PATH=/
